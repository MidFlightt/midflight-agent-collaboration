{
  "name": "midflight-pitch-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.tsx MidflightPitch out/midflight-pitch.mp4 --gl=angle --codec=h264 --crf=18 --concurrency=3",
    "render:opening": "remotion render src/index.tsx Opening out/opening.mp4 --gl=angle --codec=h264 --crf=17 --concurrency=3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@react-three/fiber": "9.3.0",
    "@remotion/cli": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/three": "4.0.533",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
