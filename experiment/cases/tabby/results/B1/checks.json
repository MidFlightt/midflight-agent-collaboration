[
  {
    "checks": [
      {
        "id": "C1",
        "event": "plain build",
        "name": "a bill's subtotal and tip",
        "command": "bill coffee:3.50:2 bagel:4.25:1 --tip 18",
        "expected": "subtotal: 11.25, tip: 2.03",
        "passed": true,
        "observed": "bill: 1\nsubtotal: 11.25\nservice: 0.56\ntip: 2.03\ntotal: 13.84"
      },
      {
        "id": "C2",
        "event": "plain build",
        "name": "showing the bill again",
        "command": "show 1",
        "expected": "the same bill, subtotal: 11.25, tip: 2.03",
        "passed": true,
        "observed": "bill: 1\nsubtotal: 11.25\nservice: 0.56\ntip: 2.03\ntotal: 13.84"
      },
      {
        "id": "C3",
        "event": "plain build",
        "name": "an unknown bill is an error",
        "command": "show 999, GET /bills/999",
        "expected": "one line starting `error:`, exit status 1; the API answers 404",
        "passed": true,
        "observed": "error: bill not found | API status 404"
      },
      {
        "id": "C4",
        "event": "plain build",
        "name": "the bill contract's field names",
        "command": "GET /bills/1",
        "expected": "JSON with numbers id, subtotal, tip, total",
        "passed": true,
        "observed": "{\"id\": 1, \"subtotal\": 11.25, \"tip\": 2.03, \"total\": 13.84, \"service\": 0.56}"
      },
      {
        "id": "C5",
        "event": "plan change",
        "name": "the service line",
        "command": "bill coffee:3.50:2 bagel:4.25:1 --tip 18",
        "expected": "service: 0.56, right after subtotal:",
        "passed": true,
        "observed": "bill: 1\nsubtotal: 11.25\nservice: 0.56\ntip: 2.03\ntotal: 13.84"
      },
      {
        "id": "C6",
        "event": "plan change",
        "name": "the total includes the service charge",
        "command": "bill coffee:3.50:2 bagel:4.25:1 --tip 18",
        "expected": "total: 13.84",
        "passed": true,
        "observed": "bill: 1\nsubtotal: 11.25\nservice: 0.56\ntip: 2.03\ntotal: 13.84"
      },
      {
        "id": "C7",
        "event": "two developers disagree",
        "name": "the default tip on the command line",
        "command": "bill coffee:3.50:2 bagel:4.25:1",
        "expected": "tip: 2.25, total: 14.06 (the lead's 20%)",
        "passed": false,
        "observed": "bill: 2\nsubtotal: 11.25\nservice: 0.56\ntip: 1.69\ntotal: 13.50"
      },
      {
        "id": "C8",
        "event": "two developers disagree",
        "name": "the default tip in the API",
        "command": "POST /bills without tip_percent",
        "expected": "tip 2.25 (the lead's 20%)",
        "passed": false,
        "observed": "{\"id\": 3, \"subtotal\": 11.25, \"tip\": 2.03, \"total\": 13.84, \"service\": 0.56}"
      },
      {
        "id": "C9",
        "event": "a note against the plan",
        "name": "splitting rounds up to the cent",
        "command": "split 1 --people 3",
        "expected": "per_person: 4.62 (13.84 / 3, rounded up)",
        "passed": false,
        "observed": "per_person: 4.61"
      }
    ],
    "events": {
      "plain build": {
        "passed": 4,
        "of": 4,
        "held": true
      },
      "plan change": {
        "passed": 2,
        "of": 2,
        "held": true
      },
      "two developers disagree": {
        "passed": 0,
        "of": 2,
        "held": false
      },
      "a note against the plan": {
        "passed": 0,
        "of": 1,
        "held": false
      }
    }
